# Backend base URL. Used by the axios client when the request path is absolute;
# when relative paths are used (e.g. /api/users) the Vite dev proxy handles routing.
VITE_API_URL=http://localhost:3001

# API token for scripts/generate-images.mjs. Used to generate the lesson
# illustration assets under public/images/exercises/. Get the token from the
# provider dashboard, paste it here, and DO NOT commit this file (.env is
# gitignored). The script reads the token at runtime, never logs it.
AVIBI_IMAGE_API_TOKEN=
